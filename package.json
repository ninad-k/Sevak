{
  "name": "sevak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "check": "svelte-check --tsconfig ui/tsconfig.json",
    "test:extensions": "node --test scripts/tests/extensions.test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "gallery:check": "node scripts/gallery-check.mjs",
    "marketplace": "node scripts/build-marketplace.mjs",
    "installer-images": "node scripts/generate-installer-images.mjs",
    "tauri": "tauri",
    "docs:pdf": "node scripts/docs-pdf.mjs",
    "docs:media-check": "node scripts/docs-media/check-media.mjs",
    "test": "vitest run --config ui/vitest.config.ts",
    "test:watch": "vitest --config ui/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ui/vitest.config.ts",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
