package() {
  bsdtar -xf data.tar.gz -C "${pkgdir}"
  # Tells Sevak that pacman owns updates, so its built-in updater stays off.
  printf 'AUR (sevak-bin)\nyay -Syu sevak-bin\n' |
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/sevak/package-manager"
}
